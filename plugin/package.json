{
  "name": "com.fcannizzaro.hoyodeck",
  "version": "1.1.0",
  "private": true,
  "description": "HoYoverse game utilities for Stream Deck",
  "author": "fcannizzaro",
  "type": "module",
  "scripts": {
    "dev": "DEBUG=1 vp build --watch",
    "build": "tsrs --noEmit && vp build",
    "package": "streamdeck pack --force-update-check  -f ./com.fcannizzaro.hoyodeck.sdPlugin",
    "link": "streamdeck link com.fcannizzaro.hoyodeck.sdPlugin",
    "typecheck": "tsrs --noEmit",
    "test": "vp test --config ../vite.config.ts --root .. --run",
    "cli": "vpx --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4",
    "@elgato/utils": "^0.6.2",
    "@fcannizzaro/streamdeck-react": "^0.4.0",
    "@fontsource/inter": "^5.3.0",
    "@hoyodeck/shared": "workspace:*",
    "@nativewindow/webview": "^1.0.7",
    "@takumi-rs/core": "^2.19.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
