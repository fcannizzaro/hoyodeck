{
  "name": "hoyodeck-monorepo",
  "private": true,
  "author": "fcannizzaro",
  "scripts": {
    "dev": "vp run --parallel --filter com.fcannizzaro.hoyodeck --filter hoyodeck-property-inspector dev",
    "build": "vp run --filter \"!hoyodeck-monorepo\" build",
    "format": "vp fmt",
    "lint": "vp lint plugin/src property-inspector/src packages/shared/src website/src",
    "typecheck": "vp run --filter \"!hoyodeck-monorepo\" typecheck",
    "test": "vp test --run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.16.1"
}
