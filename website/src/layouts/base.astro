---
import "../styles/globals.css";
import Navbar from "../components/navbar.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HoYo Deck — Stream Deck Plugin for HoYoverse Games",
  description = "Track your Genshin Impact, Honkai: Star Rail, and Zenless Zone Zero stats directly on your Stream Deck. Monitor stamina, banners, endgame progress, and more.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.webp" />
    <meta name="theme-color" content="#080b12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-white/15 selection:text-white">
    <div class="site-ambient site-ambient-one" aria-hidden="true"></div>
    <div class="site-ambient site-ambient-two" aria-hidden="true"></div>
    <div class="site-noise" aria-hidden="true"></div>

    <Navbar />
    <main class="relative overflow-hidden">
      <slot />
    </main>
  </body>
</html>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.08 },
  );

  const revealIfVisible = (el) => {
    const rect = el.getBoundingClientRect();
    const visible = rect.top < window.innerHeight * 0.92 && rect.bottom > 0;

    if (visible) {
      el.classList.add("is-visible");
      return true;
    }

    return false;
  };

  // Observe all existing [data-animate] elements
  document.querySelectorAll("[data-animate]").forEach((el) => {
    if (!revealIfVisible(el)) io.observe(el);
  });

  // Also observe dynamically added elements (React islands hydrate after page load)
  const mo = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (node instanceof HTMLElement) {
          if (node.dataset.animate && !revealIfVisible(node)) io.observe(node);
          node.querySelectorAll("[data-animate]").forEach((el) => {
            if (!revealIfVisible(el)) io.observe(el);
          });
        }
      }
    }
  });
  mo.observe(document.body, { childList: true, subtree: true });
</script>
