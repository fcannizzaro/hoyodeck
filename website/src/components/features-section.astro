---
import { crossGameActions } from "../data/actions";
---

<section id="features" class="px-6 py-24 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <!-- Section header -->
    <div class="mb-16 text-center" data-animate="fade-up">
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] uppercase text-muted-foreground/60">
        Cross-Game
      </p>
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Works Across All Games
      </h2>
      <p class="mx-auto max-w-lg text-sm leading-relaxed text-muted-foreground/70">
        These actions support Genshin Impact, Honkai: Star Rail, and Zenless Zone Zero.
        Pick your game in settings and you're ready.
      </p>
    </div>

    <!-- Cross-game action cards -->
    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
      {
        crossGameActions.map((action, i) => (
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/6 bg-white/[0.02] p-8 transition-colors hover:border-white/10"
            data-animate="fade-up"
            style={`--stagger-delay: ${i * 0.1}s`}
          >
            {/* Decorative glow */}
            <div
              class="absolute -right-16 -top-16 size-48 rounded-full opacity-0 transition-opacity group-hover:opacity-100"
              style="background: radial-gradient(circle, oklch(0.5 0.1 260 / 15%) 0%, transparent 70%);"
              aria-hidden="true"
            />

            <div class="relative">
              {/* Game compatibility icons */}
              <div class="mb-5 flex items-center gap-2">
                <img src="/icons/gi.webp" alt="GI" class="size-6 rounded object-contain opacity-60" />
                <img src="/icons/hsr.webp" alt="HSR" class="size-6 rounded object-contain opacity-60" />
                <img src="/icons/zzz.webp" alt="ZZZ" class="size-6 rounded object-contain opacity-60" />
              </div>

              {/* Action name */}
              <h3 class="mb-2 text-lg font-bold tracking-tight text-foreground">
                {action.name}
              </h3>

              {/* Description */}
              <p class="mb-5 text-sm leading-relaxed text-muted-foreground/70">
                {action.description}
              </p>

              {/* Features */}
              <div class="flex flex-wrap gap-1.5">
                {action.features.map((feature) => (
                  <span class="pill">{feature}</span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
