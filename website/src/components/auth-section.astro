---
const steps = [
  {
    title: "Install from the Marketplace",
    description:
      "Download HoYo Deck from the Elgato Marketplace. It's free and installs in seconds.",
  },
  {
    title: "Log in with HoYoLAB",
    description:
      "Open any action's settings and log in through the built-in HoYoLAB webview. Your credentials stay local on your machine.",
  },
  {
    title: "Enable Real-Time Notes",
    description:
      'Go to HoYoLAB → Settings and enable the "Real-Time Notes" switch for each game you play. This allows the plugin to read your in-game data like stamina, commissions, and expeditions.',
  },
  {
    title: "Add actions to your deck",
    description:
      "Drag and drop actions onto your Stream Deck layout. Configure each action to your account and preferred game. Data refreshes automatically.",
  },
];

const trustPoints = [
  "Secure HoYoLAB login inside the property inspector",
  "No manual cookie extraction or fragile copy-paste setup",
  "Per-action configuration for the exact game and account you want",
  "Real-Time Notes support so your device stays genuinely useful",
];
---

<section id="setup" class="section-space section-border">
  <div class="section-frame">
    <div class="setup-shell">
      <div>
        <div class="section-heading-block" data-animate="fade-up">
          <p class="section-label">Setup</p>
          <h2 class="section-title">From install to live data in a few calm clicks.</h2>
          <p class="section-copy">
            No manual cookie wrangling. Install the plugin, sign in with HoYoLAB, enable
            Real-Time Notes, and start placing actions.
          </p>
        </div>

        <div class="step-grid">
          {
            steps.map((step, i) => (
              <article
                class="step-card"
                data-animate="fade-up"
                style={`--stagger-delay: ${i * 0.08}s`}
              >
                <div class="step-index">0{i + 1}</div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-copy">{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>

      <aside class="trust-panel surface-panel" data-animate="slide-left" style="--stagger-delay: 0.12s">
        <p class="section-label">Why it feels easy</p>
        <h3 class="trust-title">The auth flow is built for normal humans, not workarounds.</h3>
        <p class="trust-copy">
          HoYo Deck keeps setup practical: sign in once, point actions at the right game,
          and let the plugin handle the data refresh loop.
        </p>

        <div class="trust-list">
          {
            trustPoints.map((point) => (
              <div class="trust-item">
                <span class="trust-check"></span>
                <p>{point}</p>
              </div>
            ))
          }
        </div>

        <div class="trust-flow">
          <span>Marketplace</span>
          <span>HoYoLAB login</span>
          <span>Enable notes</span>
          <span>Place actions</span>
        </div>
      </aside>
    </div>
  </div>
</section>
