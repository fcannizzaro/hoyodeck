---
import * as actionData from "../data/actions";
import type { InputType } from "../data/actions";

type SupportedGame = "gi" | "hsr" | "zzz";

type WebsiteActionDef = {
  id: string;
  name: string;
  description: string;
  features: string[];
  inputType: InputType;
  supportedGames?: SupportedGame[];
};

type InputBadge = { label: string; icon: string };

const gameCodes: Record<SupportedGame, string> = {
  gi: "GI",
  hsr: "HSR",
  zzz: "ZZZ",
};

const inputBadges: Record<InputType, InputBadge[]> = {
  key: [
    { label: "Key", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="3"/><circle cx="12" cy="14" r="2.5"/></svg>` },
  ],
  dial: [
    { label: "Dial", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>` },
  ],
  "key+dial": [
    { label: "Key", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="3"/><circle cx="12" cy="14" r="2.5"/></svg>` },
    { label: "Dial", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>` },
  ],
};

const sharedCoreActions: WebsiteActionDef[] = [
  {
    id: "stamina",
    name: "Stamina",
    description:
      "One unified stamina key for Resin, Trailblaze Power, or Battery Charge. Pick game in settings, press refresh.",
    features: ["GI / HSR / ZZZ", "Tap refresh", "Game-specific art"],
    inputType: "key",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "banner",
    name: "Wish Banner",
    description:
      "Unified banner action for all supported games with both key and Stream Deck+ dial layouts.",
    features: ["Key + dial", "Current 5★ pools", "Countdown timer"],
    inputType: "key+dial",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "endgame",
    name: "Endgame",
    description:
      "Unified endgame tracker that switches between each game's active challenge modes and reset windows.",
    features: ["Per-game modes", "Star progress", "Ending-soonest view"],
    inputType: "key",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "daily-reward",
    name: "Daily Reward",
    description:
      "See today's HoYoLAB login reward and claim it directly from key for selected game.",
    features: ["In-key claim", "Reward preview", "Done overlay"],
    inputType: "key",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "redeem-code",
    name: "Redeem Code",
    description:
      "Redeem available promo codes for selected game and watch progress directly on key.",
    features: ["Batch redeem", "Live status grid", "Per-game codes"],
    inputType: "key",
    supportedGames: ["gi", "hsr", "zzz"],
  },
];

const sharedUtilityActions: WebsiteActionDef[] = [
  {
    id: "stamina-overview",
    name: "Stamina Overview",
    description:
      "Stream Deck+ overview for up to three game stamina meters in one dial display.",
    features: ["Dial only", "Up to 3 slots", "Rotate focus"],
    inputType: "dial",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "wish-tracker",
    name: "Wish Tracker",
    description:
      "Manual pity counter for Stream Deck+ with rotate, press, tap, long-touch gestures.",
    features: ["Dial only", "+1 / +10", "Tap switch / hold reset"],
    inputType: "dial",
    supportedGames: ["gi", "hsr", "zzz"],
  },
  {
    id: "patch-countdown",
    name: "Patch Countdown",
    description:
      "Version countdown rows for multiple games on either key or dial layouts.",
    features: ["Key + dial", "Up to 3 games", "Refresh tap"],
    inputType: "key+dial",
    supportedGames: ["gi", "hsr", "zzz"],
  },
];

const genshin = (actionData.games as unknown as Array<{
  id: SupportedGame;
  exclusiveActions: WebsiteActionDef[];
}>).find((game) => game.id === "gi");
---

<section id="games" class="section-space">
  <div class="section-frame">
    <div class="section-heading-block" data-animate="fade-up">
      <p class="section-label">Actions</p>
      <h2 class="section-title">Shared actions first, game-specific where still matters.</h2>
      <p class="section-copy">
        HoYo Deck now runs on common action layer across all supported games. Genshin keeps
        small set of dedicated extras.
      </p>
    </div>

    <div class="shared-actions-layout">
      <div class="shared-action-block" data-animate="fade-up" style="--stagger-delay: 0.04s">
        <p class="game-action-section-label">Shared core actions</p>
        <div class="library-action-stack shared-stack">
          {sharedCoreActions.map((action: WebsiteActionDef) => (
            <div class="library-action-card compact-card">
              <div class="library-action-header">
                <div class="action-title-block">
                  <h4 class="library-action-title">{action.name}</h4>
                  <div class="supported-games-row">
                    {(action.supportedGames ?? ["gi", "hsr", "zzz"]).map((game: SupportedGame) => (
                      <img src={`/icons/${game}.webp`} alt={gameCodes[game]} title={gameCodes[game]} />
                    ))}
                  </div>
                </div>

                <div class="action-input-row">
                  {inputBadges[action.inputType].map(({ label, icon }: InputBadge) => (
                    <span class="input-badge">
                      <Fragment set:html={icon} />
                      {label}
                    </span>
                  ))}
                </div>
              </div>

              <p class="library-action-copy">{action.description}</p>

              <div class="action-tag-row">
                {action.features.map((feature: string) => (
                  <span class="pill">{feature}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="shared-action-block" data-animate="fade-up" style="--stagger-delay: 0.08s">
        <p class="game-action-section-label">Shared Stream Deck+ utilities</p>
        <div class="library-action-stack shared-stack">
          {sharedUtilityActions.map((action: WebsiteActionDef) => (
            <div class="library-action-card compact-card compact-card-muted">
              <div class="library-action-header">
                <div class="action-title-block">
                  <h4 class="library-action-title">{action.name}</h4>
                  <div class="supported-games-row">
                    {(action.supportedGames ?? ["gi", "hsr", "zzz"]).map((game: SupportedGame) => (
                      <img src={`/icons/${game}.webp`} alt={gameCodes[game]} title={gameCodes[game]} />
                    ))}
                  </div>
                </div>

                <div class="action-input-row">
                  {inputBadges[action.inputType].map(({ label, icon }: InputBadge) => (
                    <span class="input-badge">
                      <Fragment set:html={icon} />
                      {label}
                    </span>
                  ))}
                </div>
              </div>

              <p class="library-action-copy">{action.description}</p>

              <div class="action-tag-row">
                {action.features.map((feature: string) => (
                  <span class="pill">{feature}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {genshin ? (
      <div class="genshin-exclusive-section" data-animate="fade-up" style="--stagger-delay: 0.14s">
        <div class="section-heading-block section-heading-compact">
          <p class="section-label">Genshin extras</p>
          <h3 class="shared-actions-title">Dedicated Genshin-only actions.</h3>
          <p class="shared-actions-copy">
            Remaining purpose-built keys that still make sense as Genshin-specific experiences.
          </p>
        </div>

        <div class="library-action-stack shared-stack">
          {genshin.exclusiveActions.map((action: WebsiteActionDef) => (
            <div class="library-action-card compact-card compact-card-highlight">
              <div class="library-action-header">
                <div class="action-title-block">
                  <h4 class="library-action-title">{action.name}</h4>
                  <div class="supported-games-row">
                    {(action.supportedGames ?? ["gi"]).map((game: SupportedGame) => (
                      <img src={`/icons/${game}.webp`} alt={gameCodes[game]} title={gameCodes[game]} />
                    ))}
                  </div>
                </div>

                <div class="action-input-row">
                  {inputBadges[action.inputType].map(({ label, icon }: InputBadge) => (
                    <span class="input-badge">
                      <Fragment set:html={icon} />
                      {label}
                    </span>
                  ))}
                </div>
              </div>

              <p class="library-action-copy">{action.description}</p>

              <div class="action-tag-row">
                {action.features.map((feature: string) => (
                  <span class="pill pill-gi">{feature}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : null}
  </div>
</section>
