---
const frames = ["/divider/1.webp", "/divider/2.webp", "/divider/3.webp", "/divider/4.webp"];
const duration = 0.8;
---

<div class="section-frame">
  <div class="sprite-divider-shell" data-animate="fade-in">
    <div class="sprite-divider-line"></div>

    <div class="sprite-divider-core">
      <div class="sprite-divider-scene">
        <img
          src="/sprite-bg.webp"
          alt=""
          draggable="false"
          class="sprite-divider-bg"
        />
        {
          frames.map((src, i) => (
            <img
              src={src}
              alt=""
              draggable="false"
              class="sprite-divider-frame"
              style={`animation: sprite-frame ${duration}s steps(1) infinite; animation-delay: ${i * duration / 4}s; opacity: 0;`}
            />
          ))
        }
      </div>

      <p class="sprite-divider-label">three universes · one desk companion</p>
    </div>

    <div class="sprite-divider-line"></div>
  </div>
</div>
