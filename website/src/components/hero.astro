---
import { TOTAL_ACTIONS } from "../data/actions";

const stats = [
  { value: TOTAL_ACTIONS, label: "live actions" },
  { value: "3", label: "supported games" },
  { value: "Key + Dial", label: "input support" },
];

const heroHighlights = [
  "Live resin, Trailblaze Power, and battery charge",
  "Banner timers, endgame rotations, and daily rewards",
  "Built for Stream Deck keys, dials, and Stream Deck+",
];
---

<section class="hero-section">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-city-glow"></div>
    <img src="/bg.webp" alt="" class="hero-city-image" />
  </div>

  <div class="section-frame hero-frame">
    <div class="hero-copy" data-animate="fade-up">
      <span class="eyebrow-badge">Open source Stream Deck plugin</span>

      <div class="hero-game-icons" aria-label="Supported HoYoverse games">
        <span class="hero-game-icon"><img src="/icons/gi.webp" alt="Genshin Impact" /></span>
        <span class="hero-game-icon"><img src="/icons/hsr.webp" alt="Honkai: Star Rail" /></span>
        <span class="hero-game-icon"><img src="/icons/zzz.webp" alt="Zenless Zone Zero" /></span>
      </div>

      <h1 class="hero-title" data-animate="fade-up" style="--stagger-delay: 0.05s">
        Your HoYoverse dashboard, built for Stream Deck.
      </h1>

      <p class="hero-description" data-animate="fade-up" style="--stagger-delay: 0.1s">
        Track resin, Trailblaze Power, battery charge, banners, daily rewards, and
        endgame resets without opening another tab.
      </p>

      <div class="hero-actions" data-animate="fade-up" style="--stagger-delay: 0.15s">
        <a
          href="https://marketplace.elgato.com"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-primary group"
        >
          <span>Get it on Elgato Marketplace</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-50 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <a
          href="https://github.com/fcannizzaro/hoyodeck"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-secondary"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
          <span>View the GitHub repo</span>
        </a>
      </div>

      <div class="hero-highlight-grid" data-animate="fade-up" style="--stagger-delay: 0.2s">
        {
          heroHighlights.map((highlight) => (
            <div class="hero-highlight-card">
              <span class="hero-highlight-dot"></span>
              <p>{highlight}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hero-showcase surface-panel" data-animate="scale-in" style="--stagger-delay: 0.22s">
      <div class="hero-showcase-grid">
        <div class="hero-showcase-copy">
          <p class="section-label">At a glance</p>
          <h2 class="showcase-title">One glance, all the things that matter.</h2>
          <p class="showcase-copy">
            Keep your farming loop, banner timing, and endgame rotation visible on
            desk hardware that already belongs in your setup.
          </p>
        </div>

        <div class="hero-stage">
          <img src="/bg.webp" alt="" class="hero-stage-bg" />
          <div class="hero-stage-orb" aria-hidden="true"></div>

          <div class="hero-floating-card hero-floating-card-left">
            <strong>Daily reward</strong>
            <span>claim from the deck</span>
          </div>

          <div class="hero-floating-card hero-floating-card-right">
            <strong>Banner timers</strong>
            <span>rotate or tap to cycle</span>
          </div>

          <div class="hero-floating-card hero-floating-card-bottom">
            <strong>Endgame resets</strong>
            <span>stay ahead of the weekly loop</span>
          </div>

          <img
            src="/sdplus.webp"
            alt="Stream Deck Plus running HoYo Deck"
            class="hero-device-shot"
            width="600"
            height="600"
            loading="eager"
          />
        </div>
      </div>

      <div class="hero-metric-grid">
        {
          stats.map((stat) => (
            <div class="metric-card">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
