---
---

<section class="relative flex flex-col items-center justify-center overflow-hidden px-6 pt-28 pb-16">
  <!-- Background base -->
  <div class="absolute inset-0 -z-30 bg-[oklch(0.06_0.01_260)]" />

  <!-- Background cityscape image -->
  <div
    class="absolute inset-0 -z-20 bg-cover bg-center bg-no-repeat opacity-40"
    style="background-image: url('/bg.webp'); mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 95%);"
  />

  <!-- Top vignette for navbar readability -->
  <div
    class="absolute inset-x-0 top-0 -z-10 h-40"
    style="background: linear-gradient(to bottom, oklch(0.06 0.01 260 / 90%) 0%, transparent 100%);"
    aria-hidden="true"
  />

  <!-- Center radial glow — warm neon accent to match the cityscape -->
  <div
    class="absolute top-[45%] left-1/2 -z-10 h-150 w-225 -translate-x-1/2 -translate-y-1/2 animate-glow rounded-full"
    style="background: radial-gradient(ellipse, oklch(0.22 0.06 270 / 45%) 0%, oklch(0.14 0.03 220 / 20%) 40%, transparent 70%);"
    aria-hidden="true"
  />

  <!-- Content -->
  <div class="relative mx-auto max-w-3xl text-center">
    <!-- Floating Stream Deck Plus -->
    <div class="hero-device-wrapper" data-animate="fade-up">
      <div class="hero-device">
        <img
          src="/sdplus.webp"
          alt="Stream Deck Plus running HoYo Deck"
          class="hero-device-img"
          width="380"
          height="380"
          loading="eager"
        />
      </div>
    </div>

    <!-- Title -->
    <h1
      class="mb-3 mt-2 text-5xl font-extrabold tracking-tight text-foreground sm:text-6xl lg:text-7xl"
      data-animate="fade-up"
      style="--stagger-delay: 0.05s"
    >
      HoYo Deck
    </h1>

    <!-- Subtitle -->
    <p
      class="mb-8 text-xl font-light tracking-wide text-muted-foreground sm:text-2xl"
      data-animate="fade-up"
      style="--stagger-delay: 0.1s"
    >
      HoYoverse game utilities for Stream Deck
    </p>

    <!-- CTAs -->
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4" data-animate="fade-up" style="--stagger-delay: 0.15s">
      <!-- Primary: Marketplace -->
      <a
        href="https://marketplace.elgato.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 rounded-full bg-white px-7 py-3 text-sm font-semibold text-gray-900 transition-all hover:bg-white/90 hover:shadow-[0_0_24px_oklch(1_0_0/20%)]"
      >
        <span>Get it on Elgato Marketplace</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-40 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- Secondary: GitHub -->
      <a
        href="https://github.com/fcannizzaro/hoyodeck"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/4 px-7 py-3 text-sm font-medium text-muted-foreground backdrop-blur-sm transition-all hover:border-white/20 hover:text-foreground"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        Open Source on GitHub
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
        </svg>
      </a>
    </div>
  </div>
</section>
