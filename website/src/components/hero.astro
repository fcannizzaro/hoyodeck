---
import { TOTAL_ACTIONS } from "../data/actions";
---

<section class="relative flex min-h-[100dvh] flex-col items-center justify-center overflow-hidden px-6 pt-14">
  <!-- Background gradient -->
  <div class="absolute inset-0 -z-20 gradient-hero" />

  <!-- Background hero image with fade masks -->
  <div
    class="absolute inset-0 -z-10 bg-cover bg-center opacity-25"
    style="background-image: url('/hero.webp'); mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 55%, transparent 100%);"
  />

  <!-- Radial glow behind title -->
  <div
    class="absolute top-1/3 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 -translate-y-1/2 animate-glow rounded-full"
    style="background: radial-gradient(ellipse, oklch(0.25 0.04 260 / 50%) 0%, transparent 70%);"
    aria-hidden="true"
  />

  <!-- Content -->
  <div class="relative mx-auto max-w-3xl text-center">
    <!-- Game icons row -->
    <div class="mb-8 flex items-center justify-center gap-4" data-animate="fade-up">
      <img src="/icons/gi.webp" alt="Genshin Impact" class="size-10 rounded-md object-contain opacity-70 transition-opacity hover:opacity-100" />
      <img src="/icons/hsr.webp" alt="Honkai: Star Rail" class="size-10 rounded-md object-contain opacity-70 transition-opacity hover:opacity-100" />
      <img src="/icons/zzz.webp" alt="Zenless Zone Zero" class="size-10 rounded-md object-contain opacity-70 transition-opacity hover:opacity-100" />
    </div>

    <!-- Title -->
    <h1
      class="mb-5 text-5xl font-extrabold tracking-tight text-foreground sm:text-6xl lg:text-7xl"
      data-animate="fade-up"
      style="--stagger-delay: 0.05s"
    >
      Hoyo Deck
    </h1>

    <!-- Subtitle -->
    <p
      class="mb-4 text-xl font-light tracking-wide text-muted-foreground sm:text-2xl"
      data-animate="fade-up"
      style="--stagger-delay: 0.1s"
    >
      HoYoverse game utilities for Stream Deck
    </p>

    <!-- Description -->
    <p
      class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-muted-foreground/70 sm:text-lg"
      data-animate="fade-up"
      style="--stagger-delay: 0.15s"
    >
      {TOTAL_ACTIONS} actions across Genshin Impact, Honkai: Star Rail, and Zenless Zone Zero.
      Monitor stamina, track banners, claim rewards, redeem codes, and more — all at a glance.
    </p>

    <!-- CTA -->
    <div data-animate="fade-up" style="--stagger-delay: 0.2s">
      <a
        href="https://marketplace.elgato.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-7 py-3 text-sm font-medium text-foreground backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/10"
      >
        <span>Get it on Elgato Marketplace</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 opacity-50 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 animate-bounce opacity-30">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>
