---
const discordUrl = import.meta.env.PUBLIC_DISCORD_URL ?? "#";
---

<footer class="site-footer section-border">
  <div class="site-footer-bg" aria-hidden="true">
    <img src="/footer.webp" alt="" />
  </div>

  <div class="section-frame site-footer-main">
    <div class="site-footer-brand">
      <a href="#" class="brand-lockup">
        <span class="brand-mark">
          <img src="/favicon.svg" alt="" width="18" height="18" />
        </span>
        <span class="brand-wordmark">
          <strong>HoYo</strong>
          <span>Deck</span>
        </span>
      </a>

      <p>
        A polished Stream Deck companion for Genshin Impact, Honkai: Star Rail, and
        Zenless Zone Zero.
      </p>
    </div>

    <div class="site-footer-links">
      <div>
        <p class="site-footer-heading">Product</p>
        <a href="https://marketplace.elgato.com/product/hoyo-deck-8a4347c6-71eb-48fc-af07-29b575a6ab27" target="_blank" rel="noopener noreferrer">Marketplace</a>
        <a href="https://github.com/fcannizzaro/hoyodeck" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
      </div>

      <div>
        <p class="site-footer-heading">Support</p>
        <a href="https://www.patreon.com/fcannizzaro" target="_blank" rel="noopener noreferrer">Patreon</a>
        <a href="https://ko-fi.com/fcannizzaro" target="_blank" rel="noopener noreferrer">Ko-fi</a>
      </div>

      <div>
        <p class="site-footer-heading">More</p>
        <a href="https://fcannizzaro.com" target="_blank" rel="noopener noreferrer">fcannizzaro.com</a>
        <a href="#games">Supported games</a>
        <a href="#setup">Setup guide</a>
      </div>
    </div>
  </div>

  <div class="section-frame site-footer-meta">
    <p>
      Not affiliated with COGNOSPHERE PTE. LTD. / HoYoverse / miHoYo. All game
      assets and trademarks are property of their respective owners.
    </p>
  </div>
</footer>
